{
  "name": "shiplohq-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Shiplo Showcase — curated open-source static web showcases built by Shiplo HQ (Apache-2.0).",
  "license": "Apache-2.0",
  "author": "Shiplo HQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiplohq/showcase.git"
  },
  "keywords": [
    "showcase",
    "static-site",
    "education",
    "creative-coding"
  ],
  "bugs": {
    "url": "https://github.com/shiplohq/showcase/issues"
  },
  "homepage": "https://github.com/shiplohq/showcase#readme",
