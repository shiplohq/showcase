{
  "name": "money-market-junior",
  "version": "1.0.0",
  "description": "Money Market Junior — Phiên chợ tính tiền. Shiplo Showcase #06: an illustrated 2D market where learners 7-11 shop for a picnic within a fixed budget, computing totals and change with fictional tokens. Angular standalone app, static build.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build && node scripts/flatten-dist.mjs",
    "watch": "ng build --watch --configuration development",
    "test:engine": "node scripts/engine-sim.mjs"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.2"
  }
}
