{
  "schema": 1,
  "copy": {
    "appTitle": "RHYTHM CANVAS",
    "tagline": "A browser-native rhythm visualizer",
    "stageHint": "Tap anywhere to accent — T key works too",
    "playCta": "PLAY",
    "aboutTitle": "About this instrument",
    "aboutBody": [
      "Every sound here is synthesized in your browser with the Web Audio API from a small JSON score — there is no audio file, no microphone and no server. The beat grid you see is the same precomputed beats array that schedules the drums.",
      "Switch loops, pick a visual mode and tap accents on the beat. Your preferences (volume, motion, last loop) stay in this browser only."
    ],
    "aboutClientOnly": "CLIENT-ONLY — 0 network requests after load",
    "aboutMotion": "Motion can be reduced at any time: the stage becomes a static poster with a progress bar, and nothing animates except short fades.",
    "shortcutsTitle": "Keyboard",
    "shortcuts": [
      {
        "keys": "Space",
        "action": "play / pause"
      },
      {
        "keys": "1 2 3",
        "action": "mode — pulse / orbit / type"
      },
      {
        "keys": "T",
        "action": "tap accent"
      },
      {
        "keys": "M",
        "action": "mute"
      },
      {
        "keys": "← →",
        "action": "seek one beat"
      },
      {
        "keys": "Esc",
        "action": "close panel"
      }
    ],
    "modes": [
      {
        "id": "pulse",
        "key": "1",
        "label": "PULSE",
        "blurb": "Concentric rings breathe on the beat grid."
      },
      {
        "id": "orbit",
        "key": "2",
        "label": "ORBIT",
        "blurb": "Beats travel concentric orbits, one lap per bar."
      },
      {
        "id": "type",
        "key": "3",
        "label": "TYPE",
        "blurb": "Poster typography lands on every downbeat."
      }
    ],
    "autoLabel": "AUTO",
    "manualLabel": "MANUAL",
    "motionLabel": "MOTION",
    "motionOn": "FULL",
    "motionOff": "REDUCED",
    "loopLabel": "LOOP",
    "trackLabel": "Track",
    "resetLabel": "Reset preferences",
    "errorTitle": "SIGNAL LOST",
    "errorBody": "The local score data failed to load or validate. This showcase runs entirely from data/tracks.json — check the file and reload.",
    "sectionLabel": "SECTION",
    "barLabel": "BAR",
    "beatLabel": "BEAT"
  },
