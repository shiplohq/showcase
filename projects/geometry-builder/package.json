{
  "name": "geometry-builder",
  "version": "1.0.0",
  "description": "Geometry Builder — Xưởng hình học. Shiplo Showcase #03: a minimal architect's desk where children 7-11 build houses, bridges and robots from polygons by applying shape properties. Angular standalone app, static build.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build && node scripts/flatten-dist.mjs",
    "watch": "ng build --watch --configuration development",
    "test:engine": "node scripts/engine-sim.mjs"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
