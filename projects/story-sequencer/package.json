    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/bangers": "^5.2.5",
    "gsap": "^3.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.2"
  }
